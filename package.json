    "token-usage",
    "cost-estimation",
    "cli",
    "anthropic",
    "statusline",
    "meter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/callobuzz/cob-claude-meter"
  },
  "homepage": "https://github.com/callobuzz/cob-claude-meter",
  "bugs": {
    "url": "https://github.com/callobuzz/cob-claude-meter/issues"
  },
  "author": "SV",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
