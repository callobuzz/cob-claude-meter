{
  "name": "cob-claude-meter",
  "version": "0.1.3",
  "description": "CLI tool for Claude Code token usage tracking and cost estimation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-meter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "data/"
  ],
  "keywords": [
