{
  "name": "cob-claude-meter",
  "version": "0.6.0",
  "description": "CLI and web dashboard for Claude Code token usage, cost estimation and work-hours tracking",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-meter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "data/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "token-usage",
    "cost-estimation",
    "cli",
    "anthropic",
    "statusline",
    "meter",
    "time-tracking",
    "work-hours",
    "timesheet",
    "dashboard",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/callobuzz/cob-claude-meter"
  },
  "homepage": "https://github.com/callobuzz/cob-claude-meter",
  "bugs": {
    "url": "https://github.com/callobuzz/cob-claude-meter/issues"
  },
  "author": "SV",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
