# Copy to .env before running `docker compose up -d`.

# Where Claude Code writes session logs. Use forward slashes on Windows.
CLAUDE_LOGS_DIR=C:/Users/YOU/.claude/projects

# Host port for the dashboard.
CLAUDE_METER_PORT=4317

# REQUIRED for correct day boundaries. Active time is bucketed by local
# calendar day, so leaving this at UTC shifts evening work onto the wrong date.
TZ=Asia/Kolkata
